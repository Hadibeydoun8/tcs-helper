// filepath: /Users/hadibeydoun/CLionProjects/TCS_Helper/.devcontainer/devcontainer.json
{
  // Human-friendly name shown by the devcontainer UI
  "name": "macOS Cross Compile",

  // Build configuration: use the Dockerfile in .devcontainer/docker
  "build": {
    // Docker build context must include the whole workspace so the Docker daemon
    // can access source files. When devcontainer.json lives in .devcontainer, a
    // context of "." would make the build context only the .devcontainer dir
    // which causes lstat errors like "/path/.devcontainer/.devcontainer: no such file".
    // Use ".." (workspace root) and point the dockerfile path into .devcontainer.
    "dockerfile": "docker/Dockerfile",
    "context": "..",
    // By default, skip cloning osxcross during image build; the container's entrypoint will
    // clone/build at runtime if needed (faster image builds and avoids shipping SDK in image).
    "args": {
      "SKIP_OSXCROSS": "1"
    }
  },

  // Ensure the host workspace is mounted into /workspace in the container
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",

  // NOTE: moved editor settings and extensions under `customizations.vscode` (schema-friendly)
  "customizations": {
    "vscode": {
      "settings": {
        "cmake.toolchainFile": "/workspace/.devcontainer/docker/macos_toolchain.cmake",
        "cmake.generator": "Ninja"
      },
      "extensions": []
    }
  },

  // Runtime environment variables available inside the container.
  // Set to automatically download macOS SDK at container start.
  // Using ARM64 (Apple Silicon) compatible SDK for macOS 12.3+
  "containerEnv": {
    "OSXCROSS_SDK_URL": "https://github.com/joseluisq/macosx-sdks/releases/download/14.4/MacOSX14.4.sdk.tar.xz",
    "OSXCROSS_SDK_SHA256": "",
    "OSXCROSS_TARGET": "darwin23"
  },

  // Run as root so the setup script can install files into /opt/osxcross
  "remoteUser": "root",

  // Optional: show a brief message and how to start building if SDK isn't provided
  "postCreateCommand": "echo \"If you want the container to download a macOS SDK automatically, set OSXCROSS_SDK_URL in this devcontainer.json or in your host environment and reopen the folder in the container.\""
}
